# Copy this file to `.env` and fill in real values for your environment.
# Never commit the real `.env` — it's already in .gitignore.

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Local dev (docker-compose): postgresql+asyncpg://postgres:postgres@localhost:5432/masters_lodging
# Managed Postgres (Railway/Render/Neon/Supabase): use the connection string they give you,
# but keep the `+asyncpg` driver marker after `postgresql`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/masters_lodging

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_dev_only_insecure_key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS --- comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Business info (footer / schema.org / contact links) ---
BUSINESS_NAME=8888 Masters
BUSINESS_PHONE=+16024788888
BUSINESS_EMAIL=chris_stocks@yahoo.com
SITE_URL=https://8888masters.com
